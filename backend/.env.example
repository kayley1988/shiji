# 诗语雅集 - 环境配置模板
# 复制此文件为 .env 并填写实际值：cp .env.example .env

# 安全配置 - 必须设置（随机字符串即可，如 python -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=your-secure-random-key-here

# 数据库配置 - 开发环境使用 SQLite（默认，位于 backend/shiyayaji.db）
DATABASE_URL=sqlite:///shiyayaji.db
# 生产环境使用 MySQL:
# DATABASE_URL=mysql+pymysql://root:your-password@127.0.0.1:3307/shiyayaji?charset=utf8mb4

# CORS 配置 - 只允许信任的域名
CORS_ORIGINS=http://localhost:5181,http://localhost:3000,http://127.0.0.1:5181

# AI 服务 - DeepSeek API（可选）
# 前往 https://platform.deepseek.com 申请 Key
# 填好后可在应用内「我的 → AI 设置」中管理；不填则 AI 功能显示引导提示，其余功能不受影响
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# 调试模式
SQLALCHEMY_ECHO=false
